{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/7.sınıf", "destination": "/7-sinif.html" },
    { "source": "/8.sınıf", "destination": "/8-sinif.html" },
    { "source": "/7-sinif", "destination": "/7-sinif.html" },
    { "source": "/8-sinif", "destination": "/8-sinif.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
